# ==============================================================================
# LightRAG 多模态与视觉解析引擎生产配置示例模板 (.env.multimodal.example)
# 参考指南: docs/MultimodalConfigurationGuide.md
# ==============================================================================

# 基础大模型配置 (用于全局问答与知识图谱实体/关系抽取)
LLM_BASE_URL='https://hk-api.maomaoai.pro/v1'
LLM_MODEL='deepseek-v4.1-flash'
LLM_API_KEY='sk-your-llm-api-key'
LLM_MAX_TOKENS='8192'
# 必须禁用 reasoning/thinking，防止思考链污染实体提取 JSON 结构
LLM_EXTRA_BODY_JSON='{"thinking":{"type":"disabled"},"reasoning_effort":"off"}'

# 向量模型配置 (必须与底座 1024 维对齐)
EMBEDDING_PROVIDER='openai'
EMBEDDING_BASE_URL='https://llm-r60wpm2s3hsi5nsa.cn-beijing.maas.aliyuncs.com/compatible-mode/v1'
EMBEDDING_MODEL='text-embedding-v4'
EMBEDDING_API_KEY='sk-your-embedding-key'
EMBEDDING_DIM='1024'
EMBEDDING_MAX_TOKENS='8192'

# 存储目录与工作空间
WORKING_DIR=/home/ubuntu/lightrag-v2-exploration/LightRAG/sandbox_storage
OUTPUT_DIR=/home/ubuntu/lightrag-v2-exploration/LightRAG/sandbox_output
KNOWLEDGE_AUTHORIZATION_SECRET=f1dd4d4e37448da47ae5a1c6ce4e1f1fc7650cb50b5724a4fe9c435f0bd7b747
AUTH_ACCOUNTS=admin:admin123456
TOKEN_SECRET=secret-token-for-lightrag-webui-testing-123456

# ==============================================================================
# 多模态解析与动静路由分流核心配置 (核心重点)
# ==============================================================================

# 1. 动态文件解析器路由 (单图走 image_vlm 直连视觉模型; 复合文档走 mineru-i 版面切片)
LIGHTRAG_PARSER="png:image_vlm;jpg:image_vlm;jpeg:image_vlm;webp:image_vlm;bmp:image_vlm;pdf:mineru-i;docx:mineru-i;pptx:mineru-i;xlsx:mineru-i"

# 2. 单图直连视觉大模型 (VLM - Direct Image Engine)
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING="openai"
VLM_LLM_MODEL="deepseek-v4.1-flash"
VLM_LLM_BINDING_HOST="https://hk-api.maomaoai.pro/v1"
VLM_LLM_BINDING_API_KEY="sk-your-vlm-api-key"

# 3. 复合文档云端高保真解析器 (MinerU Official Cloud API)
MINERU_API_MODE="official"
MINERU_API_TOKEN="sk-your-mineru-official-token"
MINERU_MODEL_VERSION="vlm"

# 4. 图文多模态处理辅助开关 (LightRAG 核心预留)
ENABLE_IMAGE_PROCESSING="true"
ENABLE_TABLE_PROCESSING="true"
ENABLE_EQUATION_PROCESSING="true"
VISION_BASE_URL="https://hk-api.maomaoai.pro/v1"
VISION_MODEL="deepseek-v4.1-flash"
VISION_API_KEY="sk-your-vlm-api-key"
VISION_MAX_TOKENS="8192"
HF_HUB_OFFLINE='1'
HF_HUB_DISABLE_TELEMETRY='1'
